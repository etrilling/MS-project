    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "corr = 0.3\n",
    "coeff = np.array([[1, corr], [corr, 1]])\n",
    "\n",
    "np.random.seed(0)\n",
    "random_sample = np.random.multivariate_normal([0, 0], coeff, 1000)\n",
    "\n",
    "plt.scatter(random_sample[:, 0], random_sample[:, 1])\n",
    "plt.xlim(-3, 3)\n",
    "plt.ylim(-3, 3)"
   ]
  }
